# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Models (defaults shown). Composer writes; judge checks; intake parses.
# VGL_COMPOSER_MODEL=claude-opus-5-5
# VGL_JUDGE_MODEL=claude-sonnet-5-5
# VGL_INTAKE_MODEL=claude-sonnet-5-5
# VGL_EMBED_MODEL=text-embedding-3-small

# live | replay | record  — replay serves recorded responses and needs no keys
# VGL_LLM_MODE=live
